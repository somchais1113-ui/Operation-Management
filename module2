<script>
// Scroll animation
const obs = new IntersectionObserver(e => e.forEach(x => { if(x.isIntersecting) x.target.classList.add('visible'); }), { threshold: 0.07 });
document.querySelectorAll('.section').forEach(s => obs.observe(s));

// Progress
const ticked = {};
function tick(el, id) {
  ticked[id] = !ticked[id];
  el.classList.toggle('done', ticked[id]);
  const done = Object.values(ticked).filter(Boolean).length;
  const pct = Math.round(done / 10 * 100);
  document.getElementById('pfill').style.width = pct + '%';
  document.getElementById('pct').textContent = pct + '%';
}

// Case toggle
function toggleCase(id) {
  const el = document.getElementById(id);
  el.classList.toggle('open');
  const btn = el.previousElementSibling;
  if(btn) btn.querySelector('span').textContent = el.classList.contains('open') ? '▲' : '▼';
}

// Quiz
const ANSWERS = [2,1,2,3,1,0,2,3];
const EX = [
  '✅ DFM = ออกแบบให้ผลิตง่าย เร็ว ถูก ของเสียน้อย — ลด Parts, ใช้ Standard Parts, Modular Design',
  '✅ QFD = House of Quality — แปลง "เสียงลูกค้า" (WHATs) → "Design Specs" (HOWs) อย่างเป็นระบบ',
  '✅ Concurrent Engineering = ทุก Function ทำงานพร้อมกัน ไม่รอทีละขั้น → เร็วกว่า ลด Rework มาก',
  '✅ Perishable = เก็บไม่ได้ เช่น ที่นั่งเครื่องบินที่ไม่มีคนนั่ง = สูญเปล่าทันที → ต้อง Manage Demand+Capacity',
  '✅ Service Triangle: Customer + People + Systems เชื่อมกันด้วย Service Strategy ตรงกลาง',
  '✅ McDonald\'s = Production Line Approach — SOP เดียวทั่วโลก Standardize ทุกขั้นตอน',
  '✅ Line of Visibility = เส้นแบ่ง Visible (ลูกค้าเห็น) กับ Backstage (ลูกค้าไม่เห็น) ใน Service Blueprint',
  '✅ Speed to Market → Greater Market Share + Price Premiums + Quick Reaction + Set Industry Standards'
];
const WR = [
  '❌ DFM ไม่ใช่เรื่องสวยงาม (Design for Customers) หรือความปลอดภัย (Design for Safety) แต่คือ "ผลิตได้ง่าย"',
  '❌ QFD ไม่ใช่ ERP และไม่ใช่ Benchmarking — มันคือ "House of Quality" แปลง Customer Voice → Design Spec',
  '❌ Sequential คือทำทีละขั้น รอกันเป็นลำดับ Concurrent คือทำพร้อมกันทุก Function',
  '❌ Perishable ไม่ใช่เรื่องอายุอาหาร แต่คือ "ขายไม่ได้" เมื่อเวลาผ่านไป เก็บ Inventory ไว้ขายทีหลังไม่ได้',
  '❌ Service Triangle ไม่ใช่ Quality/Cost/Speed — มี 3 มุม: Customer, People, Systems',
  '❌ IKEA ใช้ Customer Involvement, Oriental Hotel ใช้ Personal Attention — McDonald\'s คือ Production Line',
  '❌ Line of Visibility ไม่ใช่เรื่อง Quality — มันแบ่ง "ที่ลูกค้าเห็น" กับ "ที่ลูกค้าไม่เห็น" ใน Blueprint',
  '❌ Speed to Market ไม่ได้ลดต้นทุน R&D — แต่ได้ Market Share, ราคา Premium, และกำหนด Standard'
];

let score = 0, done = {};
function ans(qi, chosen, correct) {
  if(done[qi]) return;
  done[qi] = true;
  if(chosen === correct) score++;
  const card = document.getElementById('qc' + qi);
  card.querySelectorAll('.q-opt').forEach((o,i) => {
    o.disabled = true;
    if(i === correct) o.classList.add(chosen === correct ? 'correct' : 'show-correct');
    if(i === chosen && chosen !== correct) o.classList.add('wrong');
  });
  const fb = document.getElementById('qf' + qi);
  fb.classList.add('show', chosen === correct ? 'ok' : 'fail');
  fb.innerHTML = chosen === correct ? EX[qi] : WR[qi] + '<br>' + EX[qi];
  if(Object.keys(done).length === 8) {
    setTimeout(() => {
      document.getElementById('scorebox').classList.add('show');
      document.getElementById('scorenum').textContent = score + '/8';
      const msgs = ['ต้องทบทวนใหม่ครับ 📖','เริ่มเข้าใจแล้ว อ่านเพิ่ม 💪','ดีมาก ใกล้พร้อม ⭐','เกือบเต็ม! 🔥','Perfect! พร้อมสอบ 🏆'];
      document.getElementById('scoremsg').textContent = msgs[Math.min(Math.floor(score/2), 4)];
      tick(document.querySelector('[onclick*="t10"]'), 't10');
    }, 500);
  }
}
function resetQ() {
  score = 0; done = {};
  document.getElementById('scorebox').classList.remove('show');
  document.querySelectorAll('.q-card').forEach(c => {
    c.querySelectorAll('.q-opt').forEach(o => { o.disabled = false; o.className = 'q-opt'; });
    const fb = c.querySelector('.q-fb');
    fb.className = 'q-fb'; fb.innerHTML = '';
  });
}
</script>
