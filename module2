          <div class="stage-detail">
            เลือก Process Type: Job Shop / Batch / Assembly Line / Continuous<br>
            วางแผน Capacity, Equipment, Layout, Workforce
          </div>
        </div>
      </div>
      <div class="stage" onclick="this.classList.toggle('open')">
        <div class="stage-dot" style="background:var(--rose-soft);border-color:var(--rose);color:var(--rose)">🚀</div>
        <div class="stage-content">
