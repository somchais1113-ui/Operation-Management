<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Module 2 — Product & Service Design</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700;800&family=Kanit:wght@400;600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap');

/* ── THEME: Forest Green / Emerald — สีเขียวธรรมชาติ สื่อถึง Product/Design ── */
:root {
  --forest:    #14532d;
  --emerald:   #059669;
  --mint:      #10b981;
  --mint-soft: #d1fae5;
  --teal:      #0d9488;
  --teal-soft: #ccfbf1;
  --amber:     #d97706;
  --amber-soft:#fef3c7;
  --rose:      #e11d48;
  --rose-soft: #ffe4e6;
  --sky:       #0284c7;
  --sky-soft:  #e0f2fe;
  --violet:    #7c3aed;
  --violet-soft:#ede9fe;
  --slate:     #475569;
  --bg:        #f8fdfb;
  --white:     #ffffff;
  --border:    #d1fae5;
  --text:      #1e293b;
  --shadow:    rgba(5,150,105,0.08);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Sarabun', sans-serif;
  font-size: 15px;
  line-height: 1.7;
  overflow-x: hidden;
}

/* ── HERO ── */
.hero {
  background: linear-gradient(150deg, var(--forest) 0%, #166534 40%, var(--emerald) 100%);
  padding: 48px 20px 64px;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 0; right: 0;
  height: 40px;
  background: var(--bg);
  clip-path: ellipse(58% 100% at 50% 100%);
}
.hero::before {
  content: '';
  position: absolute; inset: 0;
  background-image: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.04) 1px, transparent 1px),
                    radial-gradient(circle at 80% 20%, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 30px 30px;
}
.hero-inner { position: relative; }
.hero-tag {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.25);
  color: rgba(255,255,255,0.9);
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px; font-weight: 600;
  padding: 5px 14px; border-radius: 4px;
  letter-spacing: 1.5px; margin-bottom: 16px;
}
.hero h1 {
  font-family: 'Kanit', sans-serif;
  font-size: 26px; font-weight: 800;
  color: var(--white); line-height: 1.25; margin-bottom: 8px;
}
.hero h1 em { font-style: normal; color: #6ee7b7; }
.hero-sub { color: rgba(255,255,255,0.6); font-size: 13px; margin-bottom: 28px; }
.hero-parts {
  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
.hero-part {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 10px; padding: 12px 14px;
}
.hero-part-num {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px; color: #6ee7b7;
  font-weight: 600; letter-spacing: 1px; margin-bottom: 4px;
}
.hero-part-title {
  font-family: 'Kanit', sans-serif;
  font-size: 13px; font-weight: 700; color: #fff;
}
.hero-part-topics { font-size: 11px; color: rgba(255,255,255,0.55); margin-top: 3px; }

/* ── PROGRESS ── */
.sticky-progress {
  position: sticky; top: 0; z-index: 100;
  background: var(--white);
  border-bottom: 2px solid var(--border);
  padding: 10px 20px;
  box-shadow: 0 2px 12px var(--shadow);
}
.progress-top {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 7px;
  font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--slate);
}
.progress-top strong { color: var(--forest); }
.progress-bar { height: 6px; background: var(--mint-soft); border-radius: 6px; overflow: hidden; margin-bottom: 9px; }
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--forest), var(--mint));
  border-radius: 6px; width: 0%; transition: width 0.5s ease;
}
.pills { display: flex; gap: 6px; flex-wrap: wrap; }
.pill {
  font-size: 10px; font-weight: 600; padding: 3px 10px; border-radius: 20px;
  border: 1.5px solid var(--border); color: var(--slate); background: var(--bg);
  cursor: pointer; transition: all 0.2s; font-family: 'Kanit', sans-serif; user-select: none;
}
.pill.done { background: var(--forest); color: #6ee7b7; border-color: var(--forest); }

/* ── SECTION ── */
.section {
  padding: 28px 20px;
  opacity: 0; transform: translateY(20px);
  transition: opacity 0.55s ease, transform 0.55s ease;
}
.section.visible { opacity: 1; transform: translateY(0); }
.sec-label {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 600;
  letter-spacing: 2px; color: var(--emerald); text-transform: uppercase; margin-bottom: 6px;
}
.sec-label::before { content: ''; display: block; width: 20px; height: 2px; background: var(--emerald); border-radius: 2px; }
.sec-title { font-family: 'Kanit', sans-serif; font-size: 20px; font-weight: 800; color: var(--forest); line-height: 1.25; margin-bottom: 4px; }
.sec-desc { font-size: 13px; color: var(--slate); margin-bottom: 20px; }

/* ── PART DIVIDER ── */
.part-banner {
  background: linear-gradient(135deg, var(--forest), var(--emerald));
  padding: 16px 20px;
  color: var(--white);
  display: flex; align-items: center; gap: 12px;
}
.part-banner-num {
  background: rgba(255,255,255,0.15);
  border-radius: 8px; padding: 6px 12px;
  font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 600; color: #6ee7b7;
}
.part-banner-title { font-family: 'Kanit', sans-serif; font-size: 16px; font-weight: 800; }
.part-banner-sub { font-size: 12px; opacity: 0.65; margin-top: 1px; }

/* ── CARD ── */
.card {
  background: var(--white); border-radius: 14px;
  padding: 18px; box-shadow: 0 2px 16px var(--shadow);
  border: 1px solid var(--border); margin-bottom: 14px;
}
.card-title {
  font-family: 'Kanit', sans-serif; font-size: 14px; font-weight: 700;
  margin-bottom: 14px; display: flex; align-items: center; gap: 8px;
}
.note-box {
  background: var(--amber-soft); border-left: 4px solid var(--amber);
  border-radius: 0 10px 10px 0; padding: 12px 14px;
  font-size: 12px; margin-top: 12px;
}

/* ── PRODUCT DEV STAGES ── */
.stages { display: flex; flex-direction: column; gap: 0; }
.stage {
  display: flex; gap: 14px; padding: 12px 0; position: relative; cursor: pointer;
}
.stage:not(:last-child)::after {
  content: ''; position: absolute;
  left: 17px; top: 46px; bottom: 0;
  width: 2px; background: var(--mint-soft);
}
.stage-dot {
  width: 34px; height: 34px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; flex-shrink: 0; position: relative; z-index: 1;
  border: 2px solid;
}
.stage-content { flex: 1; }
.stage-name { font-family: 'Kanit', sans-serif; font-size: 13px; font-weight: 700; }
.stage-desc { font-size: 11px; color: var(--slate); margin-top: 2px; }
.stage-detail {
  display: none; margin-top: 8px;
  background: var(--mint-soft); border-radius: 8px; padding: 10px 12px;
  font-size: 12px; line-height: 1.6;
}
.stage.open .stage-detail { display: block; animation: fadeIn 0.3s ease; }

/* ── 4 DESIGN CONCEPTS — FLIP GRID ── */
.flip-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.flip-card { height: 150px; perspective: 900px; cursor: pointer; }
.flip-inner {
  width: 100%; height: 100%; position: relative;
  transform-style: preserve-3d;
  transition: transform 0.55s cubic-bezier(0.4,0,0.2,1);
}
.flip-card.flipped .flip-inner { transform: rotateY(180deg); }
.flip-f, .flip-b {
  position: absolute; inset: 0;
  backface-visibility: hidden; border-radius: 12px;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 14px; text-align: center;
}
.flip-b { transform: rotateY(180deg); }
.flip-icon { font-size: 28px; margin-bottom: 6px; }
.flip-name { font-family: 'Kanit', sans-serif; font-size: 13px; font-weight: 800; }
.flip-en { font-size: 10px; opacity: 0.6; margin-top: 2px; }
.flip-hint { font-size: 10px; opacity: 0.4; margin-top: 6px; }
.flip-def { font-size: 11px; line-height: 1.6; color: var(--white); }
.flip-bullet { font-family: 'Kanit', sans-serif; font-size: 11px; color: #6ee7b7; font-weight: 700; margin-bottom: 6px; }

/* ── QFD HOUSE ── */
.qfd-structure { display: flex; flex-direction: column; gap: 6px; }
.qfd-row { display: flex; gap: 6px; }
.qfd-box {
  border-radius: 8px; padding: 10px 12px;
  font-size: 12px; font-weight: 600; text-align: center;
  border: 2px solid; line-height: 1.4;
}

/* ── CONCURRENT ENGINEERING ── */
.ce-wrap {
  position: relative; background: var(--forest);
  border-radius: 14px; padding: 18px;
}
.ce-center {
  background: var(--mint); border-radius: 50%;
  width: 90px; height: 90px;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 14px;
  font-family: 'Kanit', sans-serif; font-size: 11px; font-weight: 800;
  color: var(--forest); text-align: center; line-height: 1.3;
  box-shadow: 0 0 0 6px rgba(16,185,129,0.2);
}
.ce-teams { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; }
.ce-team {
  border-radius: 8px; padding: 8px 6px; text-align: center;
  font-size: 10px; font-weight: 600; border: 1px solid rgba(255,255,255,0.2);
}

/* ── SPEED TO MARKET ── */
.speed-bars { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
.speed-bar-row { display: flex; align-items: center; gap: 10px; }
.speed-label { font-size: 11px; width: 80px; flex-shrink: 0; font-weight: 600; }
.speed-bar-track { flex: 1; height: 22px; background: var(--mint-soft); border-radius: 4px; overflow: hidden; }
.speed-bar-fill {
  height: 100%; border-radius: 4px;
  display: flex; align-items: center; padding-left: 8px;
  font-size: 10px; font-weight: 700; color: var(--white);
  transition: width 1s ease;
}
.speed-benefit {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 14px;
}
.benefit-box {
  background: var(--mint-soft); border-radius: 10px; padding: 12px;
  border-left: 4px solid var(--mint);
}
.benefit-box-title { font-family: 'Kanit', sans-serif; font-size: 12px; font-weight: 700; color: var(--forest); margin-bottom: 4px; }
.benefit-box-desc { font-size: 11px; color: var(--slate); }

/* ── MODERN TRENDS ── */
.trends-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.trend-item {
  background: var(--white); border-radius: 10px; padding: 12px;
  border-top: 3px solid; box-shadow: 0 1px 8px var(--shadow);
  cursor: pointer; transition: transform 0.2s;
}
.trend-item:active { transform: scale(0.98); }
.trend-icon { font-size: 22px; margin-bottom: 6px; }
.trend-name { font-family: 'Kanit', sans-serif; font-size: 12px; font-weight: 700; }
.trend-detail { display: none; font-size: 11px; color: var(--slate); margin-top: 6px; line-height: 1.5; }
.trend-item.open .trend-detail { display: block; animation: fadeIn 0.25s ease; }

/* ── SERVICE CHARACTERISTICS ── */
.char-list { display: flex; flex-direction: column; gap: 7px; }
.char-item {
  display: flex; gap: 12px; align-items: flex-start;
  background: var(--white); border-radius: 10px;
  padding: 11px 14px; border: 1px solid var(--border);
  box-shadow: 0 1px 6px var(--shadow);
}
.char-icon { font-size: 20px; flex-shrink: 0; margin-top: 1px; }
.char-name { font-family: 'Kanit', sans-serif; font-size: 12px; font-weight: 700; color: var(--forest); }
.char-desc { font-size: 11px; color: var(--slate); margin-top: 2px; }

/* ── SERVICE TRIANGLE ── */
.triangle-wrap {
  background: var(--forest); border-radius: 14px; padding: 20px;
}
.triangle-top {
  background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);
  border-radius: 10px; padding: 14px; text-align: center; margin-bottom: 14px;
}
.triangle-top-title { font-family: 'Kanit', sans-serif; font-size: 14px; font-weight: 800; color: #6ee7b7; }
.triangle-top-desc { font-size: 11px; color: rgba(255,255,255,0.65); margin-top: 4px; }
.triangle-corners { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
.tri-corner {
  background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
  border-radius: 10px; padding: 12px 8px; text-align: center;
}
.tri-icon { font-size: 24px; margin-bottom: 6px; }
.tri-name { font-family: 'Kanit', sans-serif; font-size: 11px; font-weight: 700; color: var(--white); }
.tri-desc { font-size: 10px; color: rgba(255,255,255,0.55); margin-top: 3px; line-height: 1.4; }
.tri-arrows {
  display: flex; justify-content: center; gap: 20px;
  margin-top: 12px; font-size: 12px; color: #6ee7b7;
  font-family: 'Kanit', sans-serif; font-weight: 600;
}

/* ── SERVICE BLUEPRINTING ── */
.blueprint { border-radius: 12px; overflow: hidden; border: 1px solid var(--border); }
.bp-header {
  background: var(--forest); color: var(--white);
  padding: 10px 14px; font-family: 'Kanit', sans-serif; font-size: 13px; font-weight: 700;
}
.bp-zone {
  padding: 12px 14px; font-size: 12px;
  border-bottom: 1px solid var(--border);
}
.bp-zone:last-child { border-bottom: none; }
.bp-zone-label {
  font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 600;
  letter-spacing: 1px; margin-bottom: 8px;
}
.bp-steps { display: flex; gap: 6px; flex-wrap: wrap; }
.bp-step {
  border-radius: 6px; padding: 6px 10px; font-size: 11px; font-weight: 600;
  border: 1.5px solid;
}
.bp-line {
  border-top: 2px dashed; margin: 4px 0; padding: 4px 0;
  font-family: 'Kanit', sans-serif; font-size: 10px; font-weight: 700;
  text-align: center; letter-spacing: 1px;
}

/* ── DESIGN APPROACHES ── */
.approach-cards { display: flex; flex-direction: column; gap: 10px; }
.approach {
  border-radius: 12px; overflow: hidden;
  box-shadow: 0 2px 10px var(--shadow); border: 1px solid var(--border);
  cursor: pointer;
}
.approach-head {
  padding: 12px 16px;
  display: flex; justify-content: space-between; align-items: center;
}
.approach-title { font-family: 'Kanit', sans-serif; font-size: 13px; font-weight: 700; color: var(--white); }
.approach-sub { font-size: 11px; opacity: 0.75; color: var(--white); }
.approach-body {
  display: none; padding: 12px 16px;
  font-size: 12px; line-height: 1.7;
  background: var(--white);
}
.approach.open .approach-body { display: block; animation: fadeIn 0.3s ease; }
.approach-tag {
  display: inline-block; font-size: 10px; font-weight: 700;
  padding: 2px 8px; border-radius: 10px; margin-bottom: 6px;
  font-family: 'IBM Plex Mono', monospace;
}

/* ── WELL-DESIGNED SERVICE ── */
.wds-list { display: flex; flex-direction: column; gap: 8px; }
.wds-item {
  display: flex; gap: 12px; align-items: flex-start;
  background: var(--white); border-radius: 10px; padding: 12px 14px;
  border-left: 4px solid var(--mint); box-shadow: 0 1px 6px var(--shadow);
}
.wds-num {
  width: 26px; height: 26px; border-radius: 50%;
  background: var(--mint); color: var(--white);
  font-family: 'Kanit', sans-serif; font-size: 12px; font-weight: 800;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.wds-name { font-family: 'Kanit', sans-serif; font-size: 12px; font-weight: 700; color: var(--forest); }
.wds-desc { font-size: 11px; color: var(--slate); margin-top: 2px; }

/* ── COMPARISON TABLE ── */
.comp-table { width: 100%; border-collapse: separate; border-spacing: 4px; }
.comp-table th {
  background: var(--forest); color: var(--white);
  font-family: 'Kanit', sans-serif; font-size: 11px; font-weight: 700;
  padding: 8px 10px; border-radius: 6px; text-align: center;
}
.comp-table td {
  background: var(--white); border: 1px solid var(--border);
  border-radius: 6px; padding: 8px 10px; font-size: 11px; vertical-align: top;
}
.comp-table td:first-child { font-weight: 700; color: var(--forest); background: var(--mint-soft); }

/* ── MIND MAP ── */
.mindmap { background: var(--white); border-radius: 14px; padding: 18px; box-shadow: 0 2px 16px var(--shadow); }
.mm-center {
  background: linear-gradient(135deg, var(--forest), var(--emerald));
  border-radius: 12px; padding: 14px; text-align: center;
  margin-bottom: 16px; box-shadow: 0 4px 16px rgba(5,150,105,0.25);
}
.mm-center-title { font-family: 'Kanit', sans-serif; font-size: 15px; font-weight: 800; color: #6ee7b7; }
.mm-center-sub { font-size: 11px; color: rgba(255,255,255,0.65); margin-top: 3px; }
.mm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.mm-branch { border-radius: 10px; padding: 12px; border-top: 3px solid; }
.mm-branch-title { font-family: 'Kanit', sans-serif; font-size: 11px; font-weight: 800; margin-bottom: 8px; display: flex; align-items: center; gap: 5px; }
.mm-item { font-size: 11px; padding: 2px 0 2px 12px; position: relative; }
.mm-item::before { content: '›'; position: absolute; left: 0; color: var(--slate); }
.mm-link {
  grid-column: span 2;
  background: linear-gradient(135deg, var(--forest), var(--emerald));
  border-radius: 10px; padding: 12px 14px;
  color: rgba(255,255,255,0.85); font-size: 12px; line-height: 1.7;
}
.mm-link strong { color: #6ee7b7; }

/* ── CASE STUDY ── */
.case-wrap { background: var(--white); border-radius: 14px; overflow: hidden; box-shadow: 0 4px 20px var(--shadow); }
.case-head { background: linear-gradient(135deg, var(--forest), var(--teal)); padding: 16px 20px; color: var(--white); }
.case-head h4 { font-family: 'Kanit', sans-serif; font-size: 15px; font-weight: 700; }
.case-head p { font-size: 12px; opacity: 0.7; margin-top: 3px; }
.case-body { padding: 16px 20px; }
.case-scenario { background: var(--bg); border-left: 4px solid var(--emerald); border-radius: 0 10px 10px 0; padding: 14px; font-size: 13px; line-height: 1.7; margin-bottom: 14px; }
.case-q-title { font-family: 'Kanit', sans-serif; font-size: 12px; font-weight: 700; padding: 10px 14px; border-radius: 8px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.case-a { display: none; padding: 12px 14px; font-size: 12px; line-height: 1.7; border-radius: 8px; margin-bottom: 8px; }
.case-a.open { display: block; animation: fadeIn 0.3s ease; }

/* ── QUIZ ── */
.quiz-section { background: var(--forest); padding: 28px 20px 40px; }
.quiz-header { text-align: center; margin-bottom: 20px; }
.quiz-header h3 { font-family: 'Kanit', sans-serif; font-size: 20px; font-weight: 800; color: var(--white); }
.quiz-header p { color: rgba(255,255,255,0.5); font-size: 12px; margin-top: 4px; }
.q-card { background: var(--white); border-radius: 12px; padding: 16px; margin-bottom: 12px; }
.q-num { display: inline-block; background: var(--mint); color: var(--forest); font-family: 'Kanit', sans-serif; font-size: 10px; font-weight: 800; padding: 2px 10px; border-radius: 20px; margin-bottom: 8px; }
.q-text { font-family: 'Kanit', sans-serif; font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 12px; line-height: 1.5; }
.q-opts { display: flex; flex-direction: column; gap: 6px; }
.q-opt { background: var(--bg); border: 2px solid var(--border); border-radius: 8px; padding: 9px 13px; font-size: 12px; cursor: pointer; transition: all 0.2s; text-align: left; font-family: 'Sarabun', sans-serif; }
.q-opt:hover:not(:disabled) { border-color: var(--emerald); background: var(--mint-soft); }
.q-opt.correct { background: var(--mint-soft); border-color: var(--mint); color: var(--forest); font-weight: 700; }
.q-opt.wrong { background: var(--rose-soft); border-color: var(--rose); color: #881337; }
.q-opt.show-correct { background: var(--mint-soft); border-color: var(--mint); }
.q-fb { display: none; margin-top: 8px; padding: 8px 12px; border-radius: 8px; font-size: 12px; }
.q-fb.show { display: block; }
.q-fb.ok { background: var(--mint-soft); color: var(--forest); }
.q-fb.fail { background: var(--rose-soft); color: #881337; }
.score-box { display: none; background: linear-gradient(135deg, var(--mint), var(--emerald)); border-radius: 14px; padding: 24px; text-align: center; }
.score-box.show { display: block; animation: fadeIn 0.4s ease; }
.score-box h3 { font-family: 'Kanit', sans-serif; font-size: 18px; font-weight: 800; color: var(--forest); }
.score-big { font-family: 'Kanit', sans-serif; font-size: 52px; font-weight: 800; color: var(--forest); line-height: 1; margin: 8px 0; }
