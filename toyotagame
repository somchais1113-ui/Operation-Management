}[scene]||[];return `<div class="learn-grid">${data.map(x=>`<div class="learn-card"><b>${x[0]}</b>${x[1]}</div>`).join('')}</div><div class="flow-strip"><span class="flow-pill">Observe</span><span class="flow-pill">Decide</span><span class="flow-pill">Improve</span><span class="flow-pill">Measure</span></div>`;}
function mission(scene){return {'5s':'จัดการสิ่งผิดปกติในพื้นที่ทำงาน',jidoka:'หยุด Defect ที่ต้นทาง',kanban:'ส่ง Pull Signal ให้ถูกต้อง',jit:'ทำให้ของมาตรงเวลา',kaizen:'ลด Motion Waste ด้วย Kaizen',lean:'หา Waste ตัวแม่',tps:'ประกอบภาพรวม TPS'}[scene]||'Mission';}
function openStage(i){active=i;state.selected=[];save();const s=STAGES[i];show('stage');document.getElementById('stageTitle').textContent=`Stage ${s.id}: ${s.title}`;document.getElementById('stageDesc').textContent=s.desc;document.getElementById('missionBadge').textContent=mission(s.scene);document.getElementById('clearBadge').textContent='Mission';document.getElementById('speech').innerHTML=`<b>${s.title}</b><br>${s.mentor}`;document.getElementById('brief').innerHTML=s.concept+learningBlock(s.scene)+`<div class="system-link"><b>System Link:</b> ${s.link}</div>`;document.getElementById('questHelp').textContent=s.help;document.getElementById('feedback').className='feedback';document.getElementById('feedback').innerHTML='';document.getElementById('nextBtn').style.display='none';document.getElementById('submitBtn').disabled=false;renderChoices();renderMetrics(document.getElementById('stageMetrics'));resize();if(raf)cancelAnimationFrame(raf);loop();}
function renderChoices(){const s=STAGES[active];document.getElementById('choices').innerHTML=s.choices.map((c,i)=>`<button class="choice ${state.selected.includes(i)?'selected':''}" onclick="pick(${i})">${c}</button>`).join('');}
function pick(i){const s=STAGES[active];state.selected=s.correct.length===1?[i]:(state.selected.includes(i)?state.selected.filter(x=>x!==i):[...state.selected,i]);renderChoices();}
function same(a,b){return a.length===b.length&&a.every(x=>b.includes(x));}
function submitQuest(){const s=STAGES[active];const ok=same([...state.selected].sort(),[...s.correct].sort());const fb=document.getElementById('feedback');if(ok){fb.className='feedback show ok';fb.innerHTML='✅ '+s.ok;for(const k in s.impact){state.metrics[k]=Math.max(0,Math.min(99,state.metrics[k]+s.impact[k]));}document.getElementById('nextBtn').style.display='inline-block';document.getElementById('submitBtn').disabled=true;document.getElementById('clearBadge').textContent='Clear!';}else{fb.className='feedback show no';fb.innerHTML='❌ '+s.no;state.metrics.waste=Math.min(99,state.metrics.waste+3);state.metrics.lead=Math.min(99,state.metrics.lead+2);shake();}renderMetrics(document.getElementById('stageMetrics'));save();}
function completeStage(){const s=STAGES[active];if(!state.done.includes(s.id))state.done.push(s.id);if(active+1<STAGES.length){state.current=Math.max(state.current,active+1);save();goMap();}else{save();show('final');}}
function resize(){const r=canvas.parentElement.getBoundingClientRect();canvas.width=Math.max(420,Math.floor(r.width*devicePixelRatio));canvas.height=Math.max(280,Math.floor(r.height*devicePixelRatio));ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);}
window.addEventListener('resize',resize);
function loop(){anim++;resize();draw(STAGES[active]);raf=requestAnimationFrame(loop);}
function draw(s){const w=canvas.clientWidth,h=canvas.clientHeight;ctx.clearRect(0,0,w,h);sky(w,h);cloud(w*.18,h*.15,1);cloud(w*.72,h*.12,.85);cloud(w*.48,h*.22,.55);bgFactory(w,h,s.color);ground(w,h);cozyDecor(w,h);platform(w,h,s);kaito(w*.27,h*.66+Math.sin(anim*.12)*2,s.color);objects(w,h,s);}
function sky(w,h){const g=ctx.createLinearGradient(0,0,0,h);g.addColorStop(0,'#7bdcff');g.addColorStop(.58,'#e9fbff');g.addColorStop(.59,'#86d878');g.addColorStop(1,'#54b85c');ctx.fillStyle=g;ctx.fillRect(0,0,w,h);}
function cloud(x,y,s){ctx.save();ctx.translate(x,y);ctx.scale(s,s);ctx.fillStyle='white';ctx.strokeStyle='#26324c';ctx.lineWidth=3;ctx.beginPath();ctx.arc(-28,8,20,Math.PI*.5,Math.PI*1.5);ctx.arc(-8,-7,24,Math.PI,Math.PI*1.9);ctx.arc(24,2,22,Math.PI*1.1,Math.PI*2);ctx.arc(42,13,15,Math.PI*1.5,Math.PI*.5);ctx.closePath();ctx.fill();ctx.stroke();ctx.restore();}
function bgFactory(w,h,c){const y=h*.47;for(let i=0;i<4;i++){const x=w*(.42+i*.13);rr(x-42,y-20,76,54,10,'rgba(255,250,240,.82)','#26324c');ctx.fillStyle=c+'66';ctx.fillRect(x-28,y-8,14,12);ctx.fillRect(x-6,y-8,14,12);ctx.fillRect(x+16,y-8,14,12);}ctx.fillStyle='#26324c';ctx.fillRect(w*.86,y-72,16,86);ctx.fillStyle='rgba(255,255,255,.72)';circle(w*.87,y-84,13);circle(w*.89,y-98,9);}
function ground(w,h){ctx.fillStyle='#67c866';ctx.fillRect(0,h*.72,w,h*.28);ctx.strokeStyle='rgba(38,50,76,.25)';ctx.lineWidth=2;for(let x=-60+(anim%60);x<w+60;x+=60){ctx.beginPath();ctx.moveTo(x,h*.72);ctx.lineTo(x-90,h);ctx.stroke();ctx.beginPath();ctx.moveTo(x,h*.72);ctx.lineTo(x+90,h);ctx.stroke();}for(let y=h*.76;y<h;y+=34){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}}
