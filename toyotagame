let state=JSON.parse(localStorage.getItem('cozy_omq')||'null')||{current:0,done:[],selected:[],metrics:{inventory:72,waste:76,defect:64,lead:70,flow:28}};
let active=0,anim=0,raf=null;const canvas=document.getElementById('gameCanvas');const ctx=canvas.getContext('2d');
function save(){localStorage.setItem('cozy_omq',JSON.stringify(state));}
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');if(id!=='stage'&&raf){cancelAnimationFrame(raf);raf=null;}}
function startGame(){show('map');renderMap();}function goMap(){show('map');renderMap();}
function resetGame(){localStorage.removeItem('cozy_omq');state={current:0,done:[],selected:[],metrics:{inventory:72,waste:76,defect:64,lead:70,flow:28}};show('map');renderMap();}
function cls(k,v){return k==='flow'?(v>=70?'good':v>=45?'warn':'bad'):(v<=30?'good':v<=55?'warn':'bad');}
function renderMetrics(el){const m=state.metrics;el.innerHTML=[['inventory','Inventory',m.inventory],['waste','Waste',m.waste],['defect','Defect Risk',m.defect],['lead','Lead Time',m.lead],['flow','Flow Efficiency',m.flow]].map(([k,l,v])=>`<div class="metric"><div class="metric-label">${l}</div><div class="metric-value ${cls(k,v)}">${v}%</div><div class="bar"><span style="width:${v}%;background:${k==='flow'?'var(--green)':'var(--red)'}"></span></div></div>`).join('');}
function renderMap(){renderMetrics(document.getElementById('mapMetrics'));const w=document.getElementById('world');w.innerHTML='';STAGES.forEach((s,i)=>{const done=state.done.includes(s.id);const locked=i>state.current;const d=document.createElement('div');d.className='stage-node '+(done?'done':i===state.current?'current':'')+(locked?' locked':'');d.onclick=()=>{if(!locked)openStage(i);};d.innerHTML=`<div class="stage-icon">${s.icon}</div><div class="stage-info"><h2>Stage ${s.id}: ${s.title}</h2><p>${s.desc}</p><span class="tag">${s.tag}</span></div><div class="status">${done?'✅':locked?'🔒':'▶️'}</div>`;w.appendChild(d);if(i<STAGES.length-1){const c=document.createElement('div');c.className='connector';c.textContent='↓';w.appendChild(c);}});}
