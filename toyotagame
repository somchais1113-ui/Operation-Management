function objects(w,h,s){const y=h*.67;if(s.scene==='5s'){label(w*.46,y-8,'NO LABEL',s.color);oil(w*.60,y+10);scrap(w*.70,y);board(w*.80,y-58);sign(w*.34,y-90,'5S AREA');}else if(s.scene==='jidoka'){product(w*.55,y-10,true);andon(w*.75,y-66,Math.floor(anim/18)%2?'#ff5b68':'#ffd85c');sign(w*.40,y-92,'ANDON');}else if(s.scene==='kanban'){card(w*.44,y-72,'KANBAN');stack(w*.58,y-24,3);arrow(w*.66,y-52,w*.80,y-52,s.color);sign(w*.34,y-95,'PULL');}else if(s.scene==='jit'){truck(w*.50,y-28,s.color);timebox(w*.75,y-84,'08:00-08:30');sign(w*.35,y-96,'JIT GATE');}else if(s.scene==='kaizen'){motion(w*.52,y-8);tray(w*.70,y-18,'Bolt Tray');arrow(w*.68,y-40,w*.57,y-40,s.color);sign(w*.36,y-96,'PDCA');}else if(s.scene==='lean'){bigstack(w*.55,y-52,'200');demand(w*.75,y-64,'Demand 80');sign(w*.36,y-96,'WASTE HUNT');}else{house(w*.60,y-122);sign(w*.34,y-96,'TPS HOUSE');}}
