lean:[['Why it matters','Waste ส่วนใหญ่ซ่อนอยู่ใน Flow'],['Player takeaway','Overproduction คือ Waste ตัวแม่'],['OM link','ตัด Non-value-added work จากมุมมองลูกค้า'],['Real action','ทำ Value Stream Map แล้ววง Waiting, WIP, Rework']],
