.screen.active{display:flex}.screen:before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 16% 17%,white 0 26px,transparent 27px),radial-gradient(circle at 24% 14%,white 0 19px,transparent 20px),radial-gradient(circle at 76% 18%,white 0 32px,transparent 33px),radial-gradient(circle at 84% 15%,white 0 20px,transparent 21px);opacity:.75}
#title{align-items:center;justify-content:center;text-align:center;padding:22px}.hero-logo{position:relative;z-index:1;width:126px;height:106px;border:5px solid var(--line);border-radius:30px;background:linear-gradient(160deg,#ff767f,var(--red));display:grid;place-items:center;font-size:58px;box-shadow:0 9px 0 var(--line),0 18px 0 var(--shadow);transform:rotate(-2deg);margin-bottom:20px}.hero-logo:after{content:"KAITO";position:absolute;right:-42px;bottom:12px;background:var(--yellow);border:4px solid var(--line);border-radius:999px;padding:5px 10px;font-family:'Fredoka';font-weight:700;font-size:13px;box-shadow:0 4px 0 var(--line)}
.title-main{position:relative;z-index:1;font-family:'Fredoka';font-weight:700;font-size:clamp(34px,7vw,76px);line-height:.95;color:white;text-shadow:3px 0 var(--line),-3px 0 var(--line),0 3px var(--line),0 -3px var(--line),7px 8px 0 var(--red2);margin-bottom:10px}.title-sub{position:relative;z-index:1;display:inline-block;background:var(--yellow);border:4px solid var(--line);border-radius:999px;padding:8px 16px;font-weight:900;box-shadow:0 5px 0 var(--line);margin-bottom:18px}.title-copy{position:relative;z-index:1;max-width:740px;background:rgba(255,250,240,.95);border:5px solid var(--line);border-radius:28px;padding:18px 20px;box-shadow:0 9px 0 var(--shadow);font-size:16px;line-height:1.8;color:var(--ink);margin-bottom:22px}.title-copy strong{color:var(--red2)}
.btn-primary{position:relative;z-index:1;border:5px solid var(--line);border-radius:20px;background:linear-gradient(#ff7d86,var(--red));padding:14px 28px;color:white;font-weight:900;font-size:18px;cursor:pointer;box-shadow:0 8px 0 var(--line),0 16px 0 var(--shadow);transition:.08s}.btn-primary:active{transform:translateY(6px);box-shadow:0 2px 0 var(--line)}.preview-grid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(7,1fr);gap:10px;max-width:760px;width:100%;margin-top:24px}.preview-card{background:var(--paper);border:4px solid var(--line);border-radius:20px;padding:10px 8px;font-size:12px;font-weight:900;box-shadow:0 6px 0 var(--shadow);transform:rotate(var(--r))}.preview-card:nth-child(odd){--r:-.6deg}.preview-card:nth-child(even){--r:.6deg}.preview-card span{display:block;font-size:30px;margin-bottom:4px}
.topbar{position:relative;z-index:5;height:76px;flex:0 0 auto;background:var(--paper);border-bottom:5px solid var(--line);display:flex;align-items:center;gap:12px;padding:10px 14px;box-shadow:0 6px 0 var(--shadow)}.top-title{flex:1;min-width:0}.top-title h1{font-family:'Fredoka';font-size:24px;color:var(--red2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.top-title small{display:block;color:var(--muted);font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.btn-small{border:4px solid var(--line);border-radius:16px;background:var(--cream);font-weight:900;padding:9px 13px;cursor:pointer;box-shadow:0 4px 0 var(--line)}.btn-small:active{transform:translateY(3px);box-shadow:0 1px 0 var(--line)}
.metrics{position:relative;z-index:4;display:grid;grid-template-columns:repeat(5,1fr);gap:9px;padding:12px;background:#e4fbff;border-bottom:4px solid var(--line)}.metric{background:var(--paper);border:3px solid var(--line);border-radius:18px;padding:9px;box-shadow:0 5px 0 var(--shadow)}.metric-label{font-size:11px;font-weight:900;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.metric-value{font-family:'Fredoka';font-size:22px;font-weight:700;margin-top:1px}.good{color:var(--green2)}.warn{color:#bd8000}.bad{color:var(--red2)}.bar{height:9px;border:2px solid var(--line);border-radius:99px;background:#dbe6f2;margin-top:5px;overflow:hidden}.bar span{display:block;height:100%;border-radius:99px;transition:.35s}
.map-wrap{position:relative;z-index:2;flex:1;overflow:auto;padding:22px}.world{max-width:960px;margin:0 auto;display:grid;gap:16px}.stage-node{display:grid;grid-template-columns:72px 1fr auto;gap:14px;align-items:center;background:var(--paper);border:5px solid var(--line);border-radius:30px;padding:15px;box-shadow:0 9px 0 var(--shadow);cursor:pointer;transform:rotate(var(--tilt));transition:.12s}.stage-node:hover{transform:translateY(-3px) rotate(var(--tilt))}.stage-node:nth-child(4n+1){--tilt:-.35deg}.stage-node:nth-child(4n+3){--tilt:.35deg}.stage-node.locked{opacity:.55;filter:grayscale(.45);cursor:not-allowed}.stage-node.current{background:#fff3b8;animation:floaty 1.7s ease-in-out infinite}.stage-node.done{background:#e7ffe8}@keyframes floaty{0%,100%{translate:0 0}50%{translate:0 -6px}}.stage-icon{width:70px;height:70px;border:4px solid var(--line);border-radius:22px;background:linear-gradient(#fff,#e9fbff);display:grid;place-items:center;font-size:36px;box-shadow:0 5px 0 var(--shadow)}.stage-info h2{font-size:22px;color:var(--ink);font-family:'Fredoka';font-weight:700}.stage-info p{font-size:14px;color:var(--muted);font-weight:700;line-height:1.5}.tag{display:inline-block;margin-top:8px;background:var(--yellow);border:3px solid var(--line);border-radius:999px;padding:4px 10px;font-size:12px;font-weight:900}.status{font-size:30px}.connector{text-align:center;font-size:30px;color:var(--line);font-weight:900;height:12px;line-height:12px}
.stage-layout{position:relative;z-index:2;flex:1;min-height:0;padding:14px;display:grid;grid-template-columns:1.28fr .72fr;gap:14px}.scene-card,.lesson-card{min-height:0;background:var(--paper);border:5px solid var(--line);border-radius:32px;overflow:hidden;box-shadow:0 9px 0 var(--shadow)}.scene-card{display:flex;flex-direction:column}.canvas-zone{position:relative;flex:1;min-height:390px;background:#8ee5ff}canvas{display:block;width:100%;height:100%}.mission-badge{position:absolute;left:14px;top:14px;max-width:68%;background:var(--paper);border:4px solid var(--line);border-radius:18px;padding:9px 12px;font-weight:900;line-height:1.45;box-shadow:0 5px 0 var(--shadow)}.clear-badge{position:absolute;right:14px;top:14px;background:var(--yellow);border:4px solid var(--line);border-radius:18px;padding:9px 12px;font-family:'Fredoka';font-weight:700;box-shadow:0 5px 0 var(--shadow)}.dialogue{border-top:5px solid var(--line);display:grid;grid-template-columns:60px 1fr;gap:12px;align-items:start;background:var(--cream);padding:13px}.sensei{width:60px;height:60px;border:4px solid var(--line);border-radius:20px;background:linear-gradient(#fff,#ffe08e);display:grid;place-items:center;font-size:32px;box-shadow:0 5px 0 var(--shadow)}.speech{font-weight:800;line-height:1.65}.speech b{color:var(--red2)}.lesson-card{display:flex;flex-direction:column}.brief{padding:18px;overflow:auto}.brief h2{font-family:'Fredoka';font-size:26px;color:var(--red2);margin-bottom:6px}.concept{font-size:15px;line-height:1.75;font-weight:700}.concept strong{color:var(--red2)}.concept em{font-style:normal;background:#e7ffe8;color:var(--green2);padding:1px 5px;border-radius:8px;font-weight:900}.learn-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}.learn-card{background:#fff7d8;border:4px solid var(--line);border-radius:20px;padding:12px;box-shadow:0 4px 0 var(--shadow);font-weight:800;line-height:1.55}.learn-card b{display:block;color:var(--red2);font-family:'Fredoka';font-size:18px;margin-bottom:4px}.flow-strip{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.flow-pill{background:#e9fbff;border:3px solid var(--line);border-radius:999px;padding:5px 9px;font-weight:900;font-size:12px}.system-link{margin-top:14px;background:#e9fbff;border:4px solid var(--line);border-radius:22px;padding:13px;font-weight:800;line-height:1.65;box-shadow:0 5px 0 var(--shadow)}.system-link b{color:var(--blue2)}
.quest{border-top:5px solid var(--line);background:#fff0c9;padding:15px}.quest-title{font-family:'Fredoka';font-size:22px;color:var(--blue2);font-weight:700;margin-bottom:4px}.quest-help{font-weight:800;color:var(--muted);line-height:1.55;margin-bottom:10px}.choices{display:grid;gap:9px}.choice{background:var(--paper);border:4px solid var(--line);border-radius:18px;padding:11px 13px;text-align:left;font-weight:900;line-height:1.45;cursor:pointer;box-shadow:0 5px 0 var(--shadow);transition:.08s}.choice:hover{transform:translateY(-2px);background:#e9fbff}.choice.selected{background:#fff1a5;box-shadow:0 5px 0 var(--line),inset 0 0 0 4px rgba(255,216,92,.55)}.actions{display:flex;gap:9px;margin-top:11px}.btn-action{border:4px solid var(--line);border-radius:17px;padding:11px 14px;font-weight:900;cursor:pointer;box-shadow:0 5px 0 var(--line);background:var(--paper)}.btn-action.green{background:linear-gradient(#69eba2,#35c979);color:#073a21}.btn-action.gold{background:linear-gradient(#ffe57a,#ffc93d);color:#422800}.btn-action:disabled{opacity:.45;filter:grayscale(.5);cursor:not-allowed}.feedback{display:none;margin-top:11px;border:4px solid var(--line);border-radius:20px;padding:13px;font-weight:800;line-height:1.65}.feedback.show{display:block}.feedback.ok{background:#e2ffe8;color:#126b3e}.feedback.no{background:#ffe4e8;color:#9d2431}
#final{align-items:center;justify-content:center;text-align:center;padding:22px}.final-card{position:relative;z-index:1;max-width:780px;background:var(--paper);border:5px solid var(--line);border-radius:34px;padding:30px;box-shadow:0 10px 0 var(--shadow)}.final-card h1{font-family:'Fredoka';font-size:36px;color:var(--red2);margin:8px 0}.final-card p{font-size:16px;line-height:1.8;font-weight:800}.house{display:grid;gap:9px;max-width:560px;margin:20px auto}.roof,.base,.pillar{border:4px solid var(--line);border-radius:20px;padding:12px;font-weight:900;box-shadow:0 5px 0 var(--shadow)}.roof{background:#fff1a5;color:#674200}.mid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.pillar{background:#e9fbff;color:#145c88}.base{background:#e1ffe8;color:#126b3e}
@media(max-width:920px){.stage-layout{grid-template-columns:1fr;overflow:auto}.metrics{grid-template-columns:repeat(2,1fr)}.preview-grid{grid-template-columns:repeat(2,1fr)}.stage-node{grid-template-columns:62px 1fr auto}.stage-icon{width:60px;height:60px}.canvas-zone{min-height:320px}.title-main{font-size:42px}.learn-grid{grid-template-columns:1fr}}
</style>
