'5s':[['Why it matters','พื้นที่รกจะซ่อน Waste และทำให้หา Root Cause ยาก'],['Player takeaway','ทำให้หน้างานอ่านง่าย เห็นความผิดปกติเร็ว'],['OM link','ลด Searching Time, Motion Waste และช่วย Standard Work'],['Real action','ใช้ Visual Control, Label, Shadow Board และ Before/After']],
jidoka:[['Why it matters','Defect ที่ปล่อยผ่านจะกลายเป็น Rework ทั้ง Lot'],['Player takeaway','หยุดเพื่อแก้ ดีกว่าฝืนผลิตให้ Output ดูดี'],['OM link','ลด Cost of Quality และแก้ Root Cause ที่ต้นทาง'],['Real action','ตั้ง Andon Rule ว่าใครดึงได้ และทีมต้องมาตอบสนองกี่นาที']],
kanban:[['Why it matters','ผลิตตาม Demand จริง ไม่ใช่ผลิตตามความรู้สึก'],['Player takeaway','Card คือภาษาของ Pull System'],['OM link','ลด WIP, ลด Inventory และทำให้ Bottleneck ชัด'],['Real action','คำนวณจำนวน Card จาก Demand, Lead Time และ Safety Factor']],
