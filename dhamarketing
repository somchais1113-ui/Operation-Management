<!DOCTYPE html>

<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quality × Design × Marketing @ DHA Siamwalla</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&family=Playfair+Display:wght@700;900&display=swap');

:root {
–navy:  #0f1e38;
–dha:   #c8102e;
–dha2:  #8b0a1e;
–gold:  #e8a020;
–goldf: #f5c842;
–teal:  #0d7c7c;
–green: #1e8449;
–blue:  #1a3a6e;
–purple:#6c3483;
–cream: #fdf9f4;
–white: #ffffff;
–muted: #5a6a8a;
–shadow:0 8px 32px rgba(15,30,56,0.13);
}

- { margin:0; padding:0; box-sizing:border-box; }
  body { font-family:‘Sarabun’,sans-serif; background:var(–navy); color:#1a1a2e; min-height:100vh; }

/* Hero */
.hero {
background:linear-gradient(135deg,#0f1e38 0%,#1a0030 45%,#2e0612 100%);
padding:46px 28px 40px; text-align:center; position:relative; overflow:hidden;
}
.hero::before {
content:’’; position:absolute; inset:0;
background:
radial-gradient(ellipse at 80% 20%, rgba(200,16,46,0.16) 0%, transparent 55%),
radial-gradient(ellipse at 10% 80%, rgba(108,52,131,0.14) 0%, transparent 50%),
radial-gradient(ellipse at 50% 50%, rgba(232,160,32,0.07) 0%, transparent 60%);
}
.hero-chips { display:flex; gap:8px; justify-content:center; flex-wrap:wrap; margin-bottom:16px; position:relative; }
.hero-chip {
font-size:11px; font-weight:700; letter-spacing:1px; text-transform:uppercase;
padding:5px 14px; border-radius:20px; border:1px solid rgba(255,255,255,0.2);
color:rgba(255,255,255,0.8);
}
.hero-chip.red    { background:rgba(200,16,46,0.3); border-color:rgba(200,16,46,0.5); }
.hero-chip.purple { background:rgba(108,52,131,0.3); border-color:rgba(108,52,131,0.5); }
.hero-chip.gold   { background:rgba(232,160,32,0.25); border-color:rgba(232,160,32,0.5); color:var(–goldf); }
.hero h1 { font-family:‘Playfair Display’,serif; font-size:clamp(22px,5vw,40px); color:#fff; line-height:1.2; position:relative; margin-bottom:10px; }
.hero h1 span { color:var(–goldf); }
.hero-sub { color:rgba(255,255,255,0.6); font-size:13.5px; position:relative; line-height:1.7; max-width:560px; margin:0 auto; }

/* Nav */
.page-nav {
background:#fff; display:flex; overflow-x:auto; border-bottom:2px solid #ece8e0;
position:sticky; top:0; z-index:100;
}
.nav-btn {
flex:1; min-width:110px; padding:12px 6px; border:none; background:transparent;
font-family:‘Sarabun’,sans-serif; font-size:11.5px; font-weight:600; color:var(–muted);
cursor:pointer; border-bottom:3px solid transparent; transition:all .2s; white-space:nowrap;
}
.nav-btn:hover { color:var(–navy); background:#fdf5f0; }
.nav-btn.active { color:var(–dha); border-bottom-color:var(–dha); background:#fff5f6; }

/* Sections */
.section { display:none; background:var(–cream); padding:30px 16px 52px; }
.section.active { display:block; animation:fadeUp .35s ease; }
@keyframes fadeUp { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }

.sec-label { text-align:center; font-size:11px; letter-spacing:3px; text-transform:uppercase; color:var(–muted); font-weight:600; margin-bottom:6px; }
.sec-heading { text-align:center; font-family:‘Playfair Display’,serif; font-size:clamp(18px,4vw,26px); color:var(–navy); margin-bottom:22px; font-weight:700; }
.wrap { max-width:740px; margin:0 auto; }
.card { background:white; border-radius:16px; padding:22px 18px; box-shadow:var(–shadow); margin-bottom:18px; }
.card-title { font-family:‘Playfair Display’,serif; font-size:17px; color:var(–navy); font-weight:700; margin-bottom:14px; }

/* DHA Banner */
.dha-banner {
border-radius:16px; padding:20px 18px; color:white; margin-bottom:18px;
display:flex; align-items:flex-start; gap:14px;
}
.dha-banner.red    { background:linear-gradient(135deg,var(–dha2),var(–dha)); }
.dha-banner.purple { background:linear-gradient(135deg,#4a235a,#8e44ad); }
.dha-banner.gold   { background:linear-gradient(135deg,#784212,var(–gold)); }
.dha-banner-icon { font-size:32px; flex-shrink:0; }
.dha-banner-label { font-size:10px; letter-spacing:2px; text-transform:uppercase; opacity:0.75; margin-bottom:5px; }
.dha-banner-text { font-size:13.5px; line-height:1.7; }
.dha-banner-text strong { color:var(–goldf); }

/* ── DFQ Section ── */
.dfq-triangle { display:flex; justify-content:center; margin-bottom:18px; }

/* Taguchi Loss Function */
.taguchi-wrap { background:white; border-radius:16px; padding:20px 18px; box-shadow:var(–shadow); margin-bottom:18px; }
.taguchi-title { font-family:‘Playfair Display’,serif; font-size:16px; color:var(–navy); font-weight:700; margin-bottom:14px; }

/* Robust Design */
.robust-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; margin-bottom:18px; }
.robust-card {
background:white; border-radius:12px; padding:14px 12px; text-align:center;
box-shadow:0 2px 8px rgba(0,0,0,0.07); border-top:4px solid transparent;
transition:transform .2s;
}
.robust-card:hover { transform:translateY(-3px); }
.rc1 { border-top-color:var(–dha); }
.rc2 { border-top-color:var(–gold); }
.rc3 { border-top-color:var(–green); }
.robust-icon { font-size:24px; margin-bottom:6px; }
.robust-title { font-size:12.5px; font-weight:700; color:var(–navy); margin-bottom:4px; }
.robust-desc { font-size:11.5px; color:var(–muted); line-height:1.5; }

/* 3-noise table */
.noise-table { display:flex; flex-direction:column; gap:6px; }
.noise-row {
display:grid; grid-template-columns:120px 1fr 1fr; gap:8px; align-items:start;
}
.noise-head { background:var(–navy); border-radius:8px; padding:8px 10px; }
.noise-hcell { font-size:11px; font-weight:700; color:white; }
.noise-hcell:first-child { color:var(–goldf); }
.noise-cell { background:#f8fafc; border-radius:8px; padding:9px 10px; font-size:12px; color:#444; line-height:1.5; }
.noise-label { font-size:12px; font-weight:700; color:var(–navy); background:#f0f2f5; border-radius:8px; padding:9px 10px; }

/* ── Brand Strategy ── */
.perception-gap {
background:white; border-radius:16px; padding:20px 18px; box-shadow:var(–shadow); margin-bottom:18px;
}
.pg-title { font-family:‘Playfair Display’,serif; font-size:16px; color:var(–navy); font-weight:700; margin-bottom:16px; }

.brand-quad {
display:grid; grid-template-columns:1fr 1fr; gap:0;
border-radius:12px; overflow:hidden; margin-bottom:14px;
}
.bq-cell {
padding:16px 14px; position:relative;
}
.bq-cell::after {
content:’’; position:absolute; inset:0;
border:1px solid rgba(255,255,255,0.2);
}
.bq-tl { background:linear-gradient(145deg,#145a32,#27ae60); color:white; }
.bq-tr { background:linear-gradient(145deg,#784212,#e67e22); color:white; }
.bq-bl { background:linear-gradient(145deg,#1a5276,#2471a3); color:white; }
.bq-br { background:linear-gradient(145deg,#4a235a,#8e44ad); color:white; }
.bq-label { font-size:10px; font-weight:700; opacity:0.75; letter-spacing:1px; text-transform:uppercase; margin-bottom:5px; }
.bq-title { font-size:14px; font-weight:700; margin-bottom:6px; }
.bq-desc  { font-size:11.5px; opacity:0.9; line-height:1.6; }
.bq-tag   { font-size:10.5px; font-weight:700; background:rgba(255,255,255,0.2); padding:3px 8px; border-radius:20px; display:inline-block; margin-top:6px; }
.bq-axis-x { text-align:center; font-size:11px; color:var(–muted); padding:8px 0 0; display:flex; justify-content:space-between; }
.bq-axis-y { writing-mode:vertical-lr; transform:rotate(180deg); font-size:11px; color:var(–muted); align-self:center; padding:0 8px 0 0; }

/* Packaging signals */
.signal-list { display:flex; flex-direction:column; gap:8px; }
.signal-item {
background:white; border-radius:12px; padding:13px 14px;
display:flex; align-items:flex-start; gap:12px;
box-shadow:0 2px 8px rgba(0,0,0,0.06);
border-left:5px solid transparent; transition:transform .2s;
}
.signal-item:hover { transform:translateX(4px); }
.si-icon  { font-size:22px; flex-shrink:0; }
.si-signal { font-size:10px; font-weight:700; color:var(–muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:3px; }
.si-title  { font-size:13px; font-weight:700; color:var(–navy); margin-bottom:3px; }
.si-desc   { font-size:12px; color:#444; line-height:1.6; }
.si-dha    { display:inline-block; font-size:11px; font-weight:700; padding:3px 9px; border-radius:20px; margin-top:5px; }

/* ── Marketing Section ── */
.pq-curve { background:white; border-radius:16px; padding:20px 18px; box-shadow:var(–shadow); margin-bottom:18px; }

/* Price-Quality Matrix */
.pq-matrix {
display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:14px;
}
.pqm-cell {
border-radius:10px; padding:12px 10px; text-align:center;
transition:transform .2s; cursor:default;
}
.pqm-cell:hover { transform:scale(1.03); }
.pqm-premium { background:linear-gradient(145deg,#0f1e38,#1a3a6e); color:white; }
.pqm-value   { background:linear-gradient(145deg,#145a32,#27ae60); color:white; }
.pqm-economy { background:linear-gradient(145deg,#784212,#e67e22); color:white; }
.pqm-over    { background:linear-gradient(145deg,#4a235a,#8e44ad); color:white; }
.pqm-under   { background:linear-gradient(145deg,#7b241c,#c0392b); color:white; }
.pqm-mid     { background:#f0f2f5; color:var(–navy); border:2px dashed #ccc; }
.pqm-icon    { font-size:20px; margin-bottom:5px; }
.pqm-name    { font-size:11.5px; font-weight:700; margin-bottom:4px; line-height:1.3; }
.pqm-desc    { font-size:10.5px; opacity:0.85; line-height:1.4; }

/* Willingness to Pay */
.wtp-bars { display:flex; flex-direction:column; gap:8px; }
.wtp-row { display:flex; align-items:center; gap:10px; }
.wtp-label { font-size:12px; font-weight:700; color:var(–navy); min-width:130px; }
.wtp-bar-wrap { flex:1; background:#f0f2f5; border-radius:20px; height:22px; overflow:hidden; }
.wtp-bar-fill { height:100%; border-radius:20px; display:flex; align-items:center; padding-left:10px; font-size:10.5px; font-weight:700; color:white; transition:width 1s ease; }
.wtp-val { font-size:12px; font-weight:700; color:var(–muted); min-width:50px; text-align:right; }

/* Quality Cues */
.cue-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.cue-card {
background:white; border-radius:12px; padding:14px;
box-shadow:0 2px 8px rgba(0,0,0,0.07);
border-top:4px solid transparent; transition:transform .2s;
}
.cue-card:hover { transform:translateY(-3px); }
.cue-card.intrinsic { border-top-color:var(–dha); }
.cue-card.extrinsic { border-top-color:var(–purple); }
.cue-type { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:1px; margin-bottom:5px; }
.intrinsic .cue-type { color:var(–dha); }
.extrinsic .cue-type { color:var(–purple); }
.cue-title { font-size:13px; font-weight:700; color:var(–navy); margin-bottom:5px; }
.cue-items { display:flex; flex-wrap:wrap; gap:4px; }
.cue-item { font-size:11px; font-weight:600; padding:3px 8px; border-radius:20px; }
.intrinsic .cue-item { background:#fdf2f8; color:var(–dha2); }
.extrinsic .cue-item { background:#f4ecf7; color:var(–purple); }

/* Positioning Map */
.pos-wrap { background:white; border-radius:16px; padding:20px 18px; box-shadow:var(–shadow); margin-bottom:18px; }

/* Strategy cards */
.strat-flow { display:flex; flex-direction:column; gap:8px; }
.strat-card {
background:white; border-radius:12px; padding:14px 16px;
box-shadow:0 2px 8px rgba(0,0,0,0.06);
display:flex; gap:12px; align-items:flex-start;
transition:transform .2s;
}
.strat-card:hover { transform:translateX(4px); }
.strat-num {
width:32px; height:32px; border-radius:50%;
display:flex; align-items:center; justify-content:center;
font-weight:700; font-size:14px; color:white; flex-shrink:0;
}
.strat-title { font-size:13px; font-weight:700; color:var(–navy); margin-bottom:4px; }
.strat-desc  { font-size:12px; color:#444; line-height:1.6; }
.strat-eg    { display:inline-block; font-size:11px; font-weight:700; padding:3px 9px; border-radius:20px; margin-top:5px; }

/* Integration Map */
.integration {
background:linear-gradient(135deg,var(–navy),#1a0030,var(–dha2));
border-radius:18px; padding:24px 18px; color:white; margin-bottom:18px;
}
.int-title { font-family:‘Playfair Display’,serif; font-size:18px; font-weight:700; color:var(–goldf); margin-bottom:18px; text-align:center; }
.int-flow { display:flex; flex-direction:column; gap:8px; }
.int-step { background:rgba(255,255,255,0.08); border-radius:10px; padding:12px 14px; }
.int-step-head { display:flex; align-items:center; gap:10px; margin-bottom:5px; }
.int-badge { font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; white-space:nowrap; }
.int-step-title { font-size:13px; font-weight:700; color:white; }
.int-step-desc  { font-size:12px; color:rgba(255,255,255,0.8); line-height:1.6; padding-left:2px; }
.int-arrow { text-align:center; color:var(–goldf); font-size:16px; opacity:0.6; }

/* Summary */
.summary-box {
background:linear-gradient(135deg,var(–navy),var(–dha2));
border-radius:16px; padding:20px 18px; color:white;
max-width:740px; margin:22px auto 0;
display:flex; align-items:flex-start; gap:14px;
}
.summary-box-icon { font-size:28px; flex-shrink:0; }
.summary-box strong { font-family:‘Playfair Display’,serif; font-size:15px; display:block; margin-bottom:6px; color:var(–goldf); }
.summary-box p { font-size:13px; opacity:.9; line-height:1.7; }

@media(max-width:520px){
.robust-grid { grid-template-columns:1fr 1fr; }
.noise-row { grid-template-columns:90px 1fr; }
.noise-row .noise-cell:last-child { grid-column:1/-1; }
.brand-quad { grid-template-columns:1fr; }
.cue-grid { grid-template-columns:1fr; }
.pq-matrix { grid-template-columns:1fr 1fr; }
}
</style>

</head>
