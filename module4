<script>
const obs=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('visible')}),{threshold:0.06});
document.querySelectorAll('.section').forEach(s=>obs.observe(s));
const ticked={};
function tick(el,id){ticked[id]=!ticked[id];el.classList.toggle('done',ticked[id]);const pct=Math.round(Object.values(ticked).filter(Boolean).length/11*100);document.getElementById('pfill').style.width=pct+'%';document.getElementById('pct').textContent=pct+'%'}
function toggleC(id){const el=document.getElementById(id);el.classList.toggle('open');const btn=el.previousElementSibling;if(btn)btn.querySelector('span').textContent=el.classList.contains('open')?'▲':'▼'}
function calcEOQ(){
  const D=parseFloat(document.getElementById('ci_D').value)||1000;
  const S=parseFloat(document.getElementById('ci_S').value)||10;
  const H=parseFloat(document.getElementById('ci_H').value)||2.5;
  const C=parseFloat(document.getElementById('ci_C').value)||15;
  const L=parseFloat(document.getElementById('ci_L').value)||7;
  const days=parseFloat(document.getElementById('ci_days').value)||365;
  const eoq=Math.round(Math.sqrt(2*D*S/H));
  const d=D/days;const rop=Math.ceil(d*L);
  const tc=(D*C)+(D/eoq)*S+(eoq/2)*H;
  document.getElementById('r_eoq').textContent=eoq+' units';
  document.getElementById('r_d').textContent=d.toFixed(2)+' units/day';
  document.getElementById('r_rop').textContent=rop+' units';
  document.getElementById('r_tc').textContent='$'+tc.toFixed(2);
  document.getElementById('r_ord').textContent=(D/eoq).toFixed(1)+' orders/yr';
  document.getElementById('eoq-result').classList.add('show');
}
const ANSWERS=[2,1,2,1,2,1,2,2,1,3];
const EX=['✅ Stage 4 = External Integration — Integrate กับ Suppliers + Customers ภายนอก ไม่ใช่แค่ภายในองค์กร','✅ Hub & Spoke รวม Shipment ผ่าน DC → ลดเส้นทางซ้ำซ้อน ต้นทุน Logistics ต่ำกว่ามาก','✅ EOQ = √(2×800×20/4) = √8,000 = 89 units','✅ d=3,650÷365=10/day · ROP=10×5=50 units','✅ A = 80% of Annual $ Value, 20% of Items — ควบคุมเข้มงวด นับ Monthly','✅ Pull = ผลิตเมื่อ Downstream ร้องขอ (Kanban) ลด Overproduction','✅ Jidoka = Intelligent Automation เครื่องหยุดเองเมื่อพบปัญหา Build Quality in Process','✅ 5S: ① Sort ② Set in Order ③ Shine ④ Standardize ⑤ Sustain','✅ ERP Integrates ALL Functions เป็น Single System ข้อมูล Real-time ทั้งองค์กร','✅ Win-Win = ทุกคนในห่วงโซ่ได้ประโยชน์ร่วมกัน ไม่ใช่ Zero-sum'];
const WR=['❌ ความแตกต่างหลักคือ External Integration (กับ Supplier+Customer ภายนอก) ไม่ใช่แค่เรื่อง ERP','❌ Hub & Spoke ดีเพราะรวม Shipment ผ่าน DC ไม่ใช่เพราะเร็วหรือใช้คนน้อย','❌ EOQ = √(2×800×20/4) = √(32,000/4) = √8,000 = 89 ไม่ใช่ 60 หรือ 100','❌ d=3,650÷365=10/day · ROP=10×5=50 ไม่ใช่ 40 หรือ 60','❌ A items = มูลค่า $ สูง 80% แต่จำนวนน้อยแค่ 20% ไม่ใช่จำนวนมาก','❌ Pull = ผลิตเมื่อร้องขอ (ลด Overproduction) ไม่ใช่ผลิตเผื่อ ซึ่งคือ Push','❌ Jidoka ≠ Kanban หรือ Kaizen — คือ "เครื่องหยุดอัตโนมัติเมื่อพบปัญหา"','❌ 5S: ① Sort ② Set in Order ③ Shine ④ Standardize ⑤ Sustain — ข้อ 2 คือ Set in Order','❌ ERP ไม่ใช่แค่ Manufacturing — Integrate Finance, HR, Sales, Distribution ทั้งหมด','❌ Win-Win ไม่ใช่ Zero-sum — ทุกคนในห่วงโซ่ต้องได้ประโยชน์ร่วมกัน'];
let score=0,done={};
function ans(qi,chosen,correct){
  if(done[qi])return;done[qi]=true;if(chosen===correct)score++;
  const card=document.getElementById('qc'+qi);
  card.querySelectorAll('.qopt').forEach((o,i)=>{o.disabled=true;if(i===correct)o.classList.add(chosen===correct?'correct':'show-correct');if(i===chosen&&chosen!==correct)o.classList.add('wrong')});
  const fb=document.getElementById('qf'+qi);fb.classList.add('show',chosen===correct?'ok':'fail');fb.innerHTML=chosen===correct?EX[qi]:WR[qi]+'<br>'+EX[qi];
  if(Object.keys(done).length===10){setTimeout(()=>{document.getElementById('scorebox').classList.add('show');document.getElementById('scorenum').textContent=score+'/10';const msgs=['ต้องทบทวนเพิ่มครับ 📖','เริ่มดีแล้ว 💪','ดีมาก! ⭐','เกือบเต็ม! 🔥','Perfect! 🏆'];document.getElementById('scoremsg').textContent=msgs[Math.min(Math.floor(score/2),4)];tick(document.querySelector('[onclick*="t11"]'),'t11')},500)}
}
function resetQ(){score=0;done={};document.getElementById('scorebox').classList.remove('show');document.querySelectorAll('.qcard').forEach(c=>{c.querySelectorAll('.qopt').forEach(o=>{o.disabled=false;o.className='qopt'});const fb=c.querySelector('.qfb');fb.className='qfb';fb.innerHTML=''})}
</script>
