      <div class="cfield"><label>C — Cost per unit ($)</label><input type="number" id="ci_C" value="15" step="0.01"></div>
      <div class="cfield"><label>L — Lead time (days)</label><input type="number" id="ci_L" value="7"></div>
      <div class="cfield"><label>Days per year</label><input type="number" id="ci_days" value="365"></div>
    </div>
    <button class="cbtn" onclick="calcEOQ()">⚡ คำนวณ EOQ + ROP</button>
    <div class="cresult" id="eoq-result">
      <div class="rrow"><span class="rlbl">① EOQ (Q*)</span><span class="rval" id="r_eoq">—</span></div>
      <div class="rrow"><span class="rlbl">② Daily Demand (d)</span><span class="rval" id="r_d">—</span></div>
      <div class="rrow"><span class="rlbl">③ ROP (d×L)</span><span class="rval" id="r_rop">—</span></div>
      <div class="rrow"><span class="rlbl">④ Total Annual Cost</span><span class="rval" id="r_tc">—</span></div>
